    "Dictate anywhere on your Mac. Speech is recognized on device, cleaned up and typed into the app you are using." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכתבה בכל מקום ב-Mac. הדיבור מזוהה במכשיר, מנוקה ומוקלד ביישום שבו עובדים."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктуйте в любом приложении на Mac. Речь распознаётся на устройстве, очищается и вставляется туда, где вы работаете."
          }
        }
