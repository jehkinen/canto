    "Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1. The text stays on your Mac." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1. הטקסט נשאר ב-Mac שלך."
          }
        },
        "ru" : {
