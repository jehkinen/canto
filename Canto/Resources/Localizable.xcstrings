      }
    },
    "The text goes through the same steps as dictation with the current settings: punctuation, numbers, vocabulary and the skill. History shows what the model heard under each entry." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטקסט עובר את אותם שלבים כמו בהכתבה, עם ההגדרות הנוכחיות: פיסוק, מספרים, מילון ומיומנות. בהיסטוריה מופיע מתחת לכל רשומה מה שהמודל שמע."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст проходит те же шаги, что и диктовка, с текущими настройками: пунктуацию, числа, словарь и скилл. В истории под каждой записью видно, что услышала модель."
          }
        }
      }
    },
